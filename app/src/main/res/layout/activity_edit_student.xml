<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEditTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_edit"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etEditFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_first_name"
            android:inputType="textPersonName"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvEditFirstNameError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etEditLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_last_name"
            android:inputType="textPersonName"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvEditLastNameError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etEditEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvEditEmailError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvEditGradeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_grade"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <Spinner
            android:id="@+id/spEditGrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvEditGradeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvEditMajorLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_major"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <RadioGroup
            android:id="@+id/rgEditMajor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp">

            <RadioButton
                android:id="@+id/rbEditMajorCs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/major_cs" />

            <RadioButton
                android:id="@+id/rbEditMajorPhysics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/major_physics" />

            <RadioButton
                android:id="@+id/rbEditMajorRobotics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/major_robotics" />

            <RadioButton
                android:id="@+id/rbEditMajorDesign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/major_design" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvEditMajorError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/cbEditNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/checkbox_notifications"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbEditTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/checkbox_terms"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvEditTermsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_cancel" />

            <Button
                android:id="@+id/btnSaveAndReturn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/btn_save_and_return" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>