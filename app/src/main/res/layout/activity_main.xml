<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRegTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_registration"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_first_name"
            android:inputType="textPersonName"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvFirstNameError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_last_name"
            android:inputType="textPersonName"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvLastNameError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvEmailError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvGradeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_grade"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <Spinner
            android:id="@+id/spGrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvGradeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvMajorLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_major"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <RadioGroup
            android:id="@+id/rgMajor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp">

            <RadioButton
                android:id="@+id/rbMajorCs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/major_cs" />

            <RadioButton
                android:id="@+id/rbMajorPhysics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/major_physics" />

            <RadioButton
                android:id="@+id/rbMajorRobotics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/major_robotics" />

            <RadioButton
                android:id="@+id/rbMajorDesign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/major_design" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvMajorError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/cbNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/checkbox_notifications"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/checkbox_terms"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvTermsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_submit" />

    </LinearLayout>
</ScrollView>